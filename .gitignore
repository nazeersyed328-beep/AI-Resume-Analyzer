*.pdf
!sample_resumes/*.pdf
*.docx
*.doc
uploads/

# Logs and temp
*.log
*.tmp

# Test/coverage artifacts
.coverage
htmlcov/

# IDE/editor (local)
.vscode/
.idea/

# OS specific files
Thumbs.db
Desktop.ini
.DS_Store

